<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
const int qsize = 3;
int[0, qsize] count = 0;</declaration>
	<template>
		<name>Consumer</name>
		<location id="id0" x="-178" y="-161">
			<name x="-188" y="-195">Idle</name>
		</location>
		<location id="id1" x="85" y="-153">
			<name x="75" y="-187">Consumed</name>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id1"/>
			<target ref="id0"/>
		</transition>
		<transition id="id3">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="-85" y="-127">count &gt; 0</label>
			<label kind="assignment" x="-160" y="-127">count--</label>
			<nail x="-51" y="-93"/>
		</transition>
	</template>
	<template>
		<name x="5" y="5">Producer</name>
		<declaration>// Place local declarations here.
</declaration>
		<location id="id4" x="-153" y="-136">
			<name x="-163" y="-170">idle</name>
		</location>
		<location id="id5" x="110" y="-127">
			<name x="100" y="-161">produced</name>
		</location>
		<init ref="id4"/>
		<transition id="id6">
			<source ref="id5"/>
			<target ref="id4"/>
		</transition>
		<transition id="id7">
			<source ref="id4"/>
			<target ref="id5"/>
			<label kind="guard" x="-76" y="-119">count &lt; qsize</label>
			<label kind="assignment" x="-144" y="-102">count++</label>
			<nail x="-25" y="-68"/>
		</transition>
	</template>
	<system>// Place template instantiations here.
producer = Producer();
consumer = Consumer();

// List one or more processes to be composed into a system.
system producer, consumer;
</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
