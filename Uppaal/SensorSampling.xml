<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
clock clk;</declaration>
	<template>
		<name x="5" y="5">Sensor</name>
		<declaration>// Place local declarations here.
</declaration>
		<location id="id0" x="-459" y="-195">
			<name x="-469" y="-229">Idle</name>
		</location>
		<location id="id1" x="-153" y="-204">
			<name x="-163" y="-238">Sampling</name>
			<label kind="invariant" x="-163" y="-187">clk &lt;= 5</label>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="guard" x="-348" y="-289">clk &gt;= 2</label>
			<nail x="-314" y="-255"/>
		</transition>
		<transition id="id3">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="assignment" x="-348" y="-136">clk = 0</label>
			<nail x="-306" y="-144"/>
		</transition>
	</template>
	<system>// Place template instantiations here.
sensor = Sensor();
// List one or more processes to be composed into a system.
system sensor;
</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
